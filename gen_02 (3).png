# Touch me — переменные окружения (все необязательны)

# Скопируйте при необходимости:  cp .env.example .env
#
# ВАЖНО: с версии 0.3.0 интерфейс сам работает с API живого ComfyUI
# (тот же origin, что и страница /mobile): списки моделей, LoRA,
# сэмплеров и генерация — напрямую, без переменных окружения.
# Папка моделей определяется самим ComfyUI (на Colab — Google Drive:
# My Drive/ComfyUI/models).

# Пример на будущее: адрес СТОРОННЕГО сервера ComfyUI, если интерфейс
# захостить отдельно (GitHub Pages и т.п.). Сейчас не используется —
# интерфейс всегда обращается к серверу, который его отдал.
# COMFYUI_SERVER_URL=https://your-tunnel.trycloudflare.com
